FROM eclipse-temurin:25-jdk-alpine

WORKDIR /app

# Sao chép Maven wrapper và pom.xml
COPY .mvn/ .mvn
COPY mvnw pom.xml ./
RUN chmod +x mvnw

# Tải trước các dependencies về cache
RUN ./mvnw dependency:go-offline

# Sao chép toàn bộ mã nguồn
COPY src ./src

EXPOSE 8080

CMD ["./mvnw", "spring-boot:run"]
