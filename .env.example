# ==============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG DỰ ÁN UNICARE (PostgreSQL Online / Cloud)
# ==============================================================================

# Cổng máy chủ Spring Boot
SERVER_PORT=8080

# Cấu hình Cơ sở dữ liệu PostgreSQL Online (Neon, Supabase, Aiven, Railway...)
DB_HOST=your-postgres-cloud-host.com
DB_PORT=5432
DB_NAME=unicare_db
DB_USER=your_db_username
DB_PASS=your_db_password
DB_SSLMODE=require

# Cấu hình JWT Bảo mật (HS256 yêu cầu khóa tối thiểu 256-bit)
JWT_SECRET=unicareSecretKeyForStudentHealthManagementSystem2026UniCareGroup2VerySecureKeyMustBe256Bits
JWT_EXPIRATION=86400000
